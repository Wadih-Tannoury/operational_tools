# Copy this into Streamlit Community Cloud under "Advanced settings -> Secrets",
# or save it locally as app/.streamlit/secrets.toml (never commit the real file).

[auth]
# username = "<hash printed by tools/make_password_hash.py>"
wadih = "pbkdf2_sha256$260000$0123456789abcdef0123456789abcdef$replace-me"
ops   = "pbkdf2_sha256$260000$fedcba9876543210fedcba9876543210$replace-me"

[github]
# A fine-grained personal access token scoped to this one repository with
# Contents: Read and write.
token       = "github_pat_..."
repo        = "your-org/kibo-cancellation-tool"
branch      = "main"
input_dir   = "input"
logs_dir    = "logs"
archive_dir = "archive"
error_dir   = "error"
